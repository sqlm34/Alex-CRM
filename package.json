{
  "name": "alex-appliance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-production-env.mjs && tsc -b && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:preview:dry-run": "wrangler deploy --config wrangler.preview.json --dry-run",
    "worker:preview:upload": "wrangler versions upload --config wrangler.preview.json",
    "worker:nestwise-staging:dry-run": "node scripts/nestwise-staging-preflight.mjs && wrangler deploy --config wrangler.nestwise-staging.json --dry-run",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs scripts/*.test.cjs",
    "test:mcp": "tsx --test scripts/mcp.test.ts",
    "test:mcp-ui": "tsx --test scripts/mcp-confirmation-ui.test.ts",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json",
    "google-actions:generate-feeds": "node scripts/google-actions-feeds.mjs",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.106.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "decimal.js": "^10.6.0",
    "heic-to": "1.5.2",
    "jose": "6.2.13",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tough-cookie": "^6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@cloudflare/workers-types": "^4.20260523.1",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@types/google.maps": "^3.64.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.27.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.23.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.94.0",
    "miniflare": "4.20260521.0"
  }
}
